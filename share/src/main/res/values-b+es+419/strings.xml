<?xml version="1.0" encoding="utf-8"?>
<!--
  Overrides only, not a full translation: anything absent here resolves to values-es, so future
  Spanish edits reach Latin America without being duplicated.

  What differs is register, not vocabulary: Latin America says "presiona" where Spain says "toca",
  writes "ícono" with the accent, shortens "aplicación" to "app", and reports finished events in
  the preterite ("no se detectó") rather than Spain's present perfect ("no se ha detectado").
-->
<resources>
  <string name="hint_decode_short_url">Presiona el ícono de descarga en la nube para resolver URL cortas &#x261D;</string>
  <string name="hint_redirect_failed">Error de red, presiona para reintentar &#x261D;</string>
  <string name="hint_redirect_not_detected">No se detectó ninguna redirección &#x1F44D;</string>
  <string name="hint_use_sharesheet_instead">También puedes compartir texto desde cualquier app con el menú para compartir de Android</string>
  <string name="no_app_to_open_url">No hay ninguna app para abrir la URL</string>
  <string name="title_activity_sanitize">Limpiador de URL simple</string>
  <string name="unable_to_parse">No se pudo limpiar la URL</string>
  <string name="url_not_detected">No se detectó ninguna URL</string>
</resources>
