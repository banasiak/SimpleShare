<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- every URL this app touches is forced to https, so cleartext is never needed -->
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system" />
    </trust-anchors>
  </base-config>
</network-security-config>